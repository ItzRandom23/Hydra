# Required. Get the token from your application's Bot page.
DISCORD_TOKEN=
MONGODB_URI=mongodb://127.0.0.1:27017/hydra
LAVALINK_NODES='[{"identifier":"local","host":"127.0.0.1","port":2333,"password":"","useSSL":false}]'

# A bot mention works as an alternative to the prefix.
HYDRA_PREFIX=!
HYDRA_OWNER_IDS=
HYDRA_SEARCH_PLATFORM=scsearch
HYDRA_AUTOPLAY_PLATFORMS=soundcloud
# Optional comma-separated exact HTTPS hosts for additional trusted media providers.
HYDRA_MEDIA_HOSTS=
# Set true to cache server members and enable the DJ members command. Also enable
# Server Members Intent in the Discord Developer Portal.
HYDRA_MEMBERS_INTENT=false
